# Copy to .env and fill in.  Never commit .env.
#
# RSIAgent talks to any OpenAI-compatible /chat/completions endpoint, so one
# key covers OpenAI, OpenRouter, vLLM, Ollama, DeepSeek, GLM, Kimi, MiniMax,
# and friends -- set OPENAI_BASE_URL to pick the host.
#
# Warning worth repeating: several vendors serve the same model on
# region-specific hosts and keys do NOT transfer between them.  A 401 from one
# host is usually a wrong-host error rather than a bad key.  The client prints
# the base URL it actually used in every error message for exactly this reason.

# --- OpenAI-compatible -----------------------------------------------------
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Native Anthropic ------------------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- Paths (optional; defaults derive from the checkout) -------------------
# RSIAGENT_WORKSPACE=/path/to/workspace
# RSIAGENT_RUN_DIR=/path/to/runs/latest
